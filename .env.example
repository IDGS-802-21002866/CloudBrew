# Copia este archivo a .env y completa con tus valores locales

# Clave secreta para sesiones 
SECRET_KEY=tu_clave_secreta_aqui

# URL de conexión a la base de datos
# MySQL: mysql+pymysql://usuario:contraseña@host:puerto/base_datos
# PostgreSQL: postgresql://usuario:contraseña@host:puerto/base_datos
# SQLite: sqlite:///nombre_archivo.db
DATABASE_URL=mysql+pymysql://usuario:contraseña@127.0.0.1/cloud_brew
